<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Inicio</title>
</head>
<body>
    <h1>Lista de usuarios</h1>
    <table border="1" cellpadding="5" cellspacing="0">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            <% users.forEach(user => { %>
                <tr>
                    <td><%= user.id %></td>
                    <td><%= user.name %></td>
                    <td><%= user.email %></td>
                    <td>
                        <a href="/edit/<%= user.id %>">Editar</a>
                        |
                        <a href="/delete/<%= user.id %>" onclick="return confirm('¿Estás seguro de eliminar este usuario?')">Eliminar</a>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <hr>

    <!-- Formulario para agregar un nuevo usuario -->
    <h2>Agregar Usuario</h2>
    <form action="/create" method="post">
        <label for="name">Nombre: </label>
        <input type="text" name="name" id="name" maxlength="45" required placeholder="Ingresa nombre de Usuario">
        <br><br>
        <label for="email">Correo: </label>
        <input type="email" name="email" id="email" maxlength="45" required placeholder="Ingresa Correo">
        <br><br>
        <button type="submit">Registrar</button>
    </form>
</body>
</html>
